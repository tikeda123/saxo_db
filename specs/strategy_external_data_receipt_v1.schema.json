{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.saxo-db.invalid/schemas/strategy-external-data-receipt-v1.json",
  "title": "Strategy Analysis external data receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "contract_id",
    "dataset_role",
    "availability_state",
    "source_observed_at_utc",
    "available_at_utc",
    "freshness_state",
    "quality_state",
    "revision_state",
    "warning_ids",
    "blocker_ids",
    "values_modified",
    "interpolation_performed",
    "payload",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "contract_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "dataset_role": {"type": "string", "minLength": 1, "maxLength": 80},
    "availability_state": {"enum": ["AVAILABLE", "AVAILABLE_WITH_WARNINGS", "DATA_NOT_READY", "BLOCKED_EXTERNAL_CONTRACT", "BLOCKED_INTERFACE_OPERATIONAL", "FAIL_DATA_QUALITY"]},
    "dataset_id": {"type": ["string", "null"], "maxLength": 160},
    "provider_id": {"type": ["string", "null"], "maxLength": 160},
    "provider_data_version": {"type": ["string", "null"], "maxLength": 256},
    "lineage_id": {"type": ["string", "null"], "maxLength": 256},
    "manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
    "ordered_content_sha256": {"$ref": "#/$defs/nullableSha256"},
    "calendar_id": {"type": ["string", "null"], "maxLength": 160},
    "source_as_of": {"type": ["string", "null"]},
    "source_observed_at_utc": {"type": "string", "format": "date-time"},
    "available_at_utc": {"type": "string", "format": "date-time"},
    "accepted_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "expected_by_utc": {"type": ["string", "null"], "format": "date-time"},
    "published_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "freshness_state": {"enum": ["CURRENT", "DELAYED", "DATA_NOT_READY", "STALE", "NOT_EVALUATED_SLA", "BLOCKED_INTERFACE_OPERATIONAL"]},
    "quality_state": {"enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL_DATA_QUALITY", "NOT_EVALUATED"]},
    "revision_state": {"enum": ["CURRENT_ACCEPTED", "REVISION_DETECTED", "REVISION_REVIEW_PENDING", "REVISION_ACCEPTED_NEXT_DECISION", "SUPERSEDED", "NOT_EVALUATED"]},
    "cost_confidence": {"enum": ["ACTUAL_BOOKED", "PUBLISHED_SCHEDULE_ESTIMATE", "RESEARCH_MODEL_ONLY", "UNKNOWN", "NOT_APPLICABLE"]},
    "warning_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocker_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "values_modified": {"const": false},
    "interpolation_performed": {"const": false},
    "account_fingerprint": {"type": ["string", "null"], "maxLength": 128},
    "payload": {"type": "object"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "supersedes_receipt_id": {"type": ["string", "null"], "maxLength": 160}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  }
}
